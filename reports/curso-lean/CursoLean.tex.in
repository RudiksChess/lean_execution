\directlua{
  function leanbreak(s)
    local previo = ""
    for _, c in utf8.codes(s) do
      local ch = utf8.char(c)
      if ch:match("^[A-Z]$") and previo:match("^[a-z]$") then
        tex.sprint("\\allowbreak{}")
      end
      tex.sprint(-2, ch)
      if ch == "_" or ch == "." then tex.sprint("\\allowbreak{}") end
      previo = ch
    end
  end
}
